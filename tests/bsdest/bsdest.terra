#include "TerraGrp.defs"

// TerraGrp: mensagem do mote para a estação base (SEND_BS, pelo CTP) depois de um pacote da
// serial na BS. Nos LEDs do mote: 1 ao começar e 2 no SENDBS_DONE. O teste confere a mensagem
// na serial da BS.
pktype msgBS from msgBS_t with
  var ubyte a;
  var ubyte b;
end
var msgBS d;
d.msgId = 7;
d.a = 90;
d.b = 165;
emit LEDS(1);
await 20s;
emit SEND_BS(d);
await SENDBS_DONE();
emit LEDS(2);
await FOREVER;
