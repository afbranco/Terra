#include "TerraGrp.defs"

// Status do SENDBS_DONE (#83, #113): é ubyte no .defs (o error_t do TinyOS), e a VM guarda 1 byte.
// O await copia para a variável o tamanho dela: até o #96 o .defs dizia ushort e a VM guardava 1
// byte; o #96 passou a 2 bytes e quem lia num ubyte recebia o byte alto (sempre 0). O 11 manda
// 20 SEND_BS seguidos; a fila de saída enche e alguns voltam com EBUSY (5 no TinyOS).
// LEDs do 11: bit 0, algum status 0; bit 1, algum status 5 (EBUSY); bit 2, algum outro valor.
// Esperado 3. Com a VM de 2 bytes, o EBUSY chega como 0 (só o bit 0).
pktype msgBS from msgBS_t with
  var ubyte a;
end
var msgBS m;
var ubyte v;
var ubyte flags = 0;
var ubyte i;
m.msgId = 7;
await 3s;
if getNodeId() == 11 then
  loop i, 20 do
    emit SEND_BS(m);
    v = await SENDBS_DONE();
    if v == 0 then
      flags = flags | 1;
    else/if v == 5 then
      flags = flags | 2;
    else
      flags = flags | 4;
    end
  end
  emit LEDS(flags);
end
await FOREVER;
